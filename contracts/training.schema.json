{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ritmo.local/contracts/training-v2",
  "title": "Ritmo — treinos estruturados, sessões e biblioteca",
  "oneOf": [
    {
      "$ref": "#/definitions/workout"
    },
    {
      "$ref": "#/definitions/session"
    },
    {
      "$ref": "#/definitions/library"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "goal": {
      "description": "Limites e resultados usam unidades canônicas por métrica: reps=contagem; load=kg; rir=contagem 0 a 10; rpe=escala 0 a 10; duration=segundos; distance=metros; heartRate=bpm; power=W; cadence=rpm; pace=segundos por km. Em record não há limites; range/exact usam min e max; min e max usam o limite correspondente. Não converter unidades implicitamente.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "mode",
        "required"
      ],
      "properties": {
        "metric": {
          "enum": [
            "reps",
            "load",
            "rir",
            "rpe",
            "duration",
            "distance",
            "heartRate",
            "power",
            "cadence",
            "pace",
            "rest",
            "percent1rm"
          ]
        },
        "mode": {
          "enum": [
            "record",
            "range",
            "min",
            "max",
            "exact"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "range",
                  "exact"
                ]
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "min"
              }
            }
          },
          "then": {
            "required": [
              "min"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "max"
              }
            }
          },
          "then": {
            "required": [
              "max"
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "role",
        "equipment",
        "notes",
        "goals"
      ],
      "properties": {
        "kind": {
          "const": "step"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "role": {
          "enum": [
            "warmup",
            "work",
            "top",
            "backoff",
            "drop",
            "recovery",
            "technique",
            "cooldown",
            "custom"
          ]
        },
        "equipment": {
          "type": "string",
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "goals": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/goal"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/definitions/series"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "repeat",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "group"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/definitions/step"
        },
        {
          "$ref": "#/definitions/group"
        }
      ]
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "revision",
        "title",
        "sport",
        "notes",
        "nodes"
      ],
      "properties": {
        "kind": {
          "const": "workout"
        },
        "schemaVersion": {
          "const": 2
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "sport": {
          "enum": [
            "strength",
            "running",
            "cycling",
            "swimming",
            "martial",
            "mixed",
            "other"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "load": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "rir": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "rpe": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "heartRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "power": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "cadence": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "pace": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 36000
        },
        "rest": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "percent1rm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 150
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "stepId",
        "values",
        "done",
        "skipped",
        "note"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "stepId": {
          "$ref": "#/definitions/id"
        },
        "values": {
          "$ref": "#/definitions/values"
        },
        "done": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "extra": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "afterKey",
            "role",
            "goals"
          ],
          "properties": {
            "afterKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "role": {
              "enum": [
                "warmup",
                "work",
                "top",
                "backoff",
                "drop",
                "recovery",
                "technique",
                "cooldown",
                "custom"
              ]
            },
            "goals": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "$ref": "#/definitions/goal"
              }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "date",
        "plan",
        "entries",
        "completed",
        "note"
      ],
      "properties": {
        "kind": {
          "const": "session"
        },
        "schemaVersion": {
          "const": 2
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "date": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        },
        "plan": {
          "$ref": "#/definitions/workout"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": {
            "$ref": "#/definitions/entry"
          }
        },
        "completed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "programId",
            "programRevision",
            "slotId",
            "day",
            "programTitle",
            "stimulus"
          ],
          "properties": {
            "programId": {
              "$ref": "#/definitions/id"
            },
            "programRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "slotId": {
              "$ref": "#/definitions/id"
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            },
            "programTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "stimulus": {
              "type": "string",
              "maxLength": 150
            },
            "activationId": {
              "$ref": "#/definitions/id"
            }
          }
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "workouts",
        "sessions",
        "active"
      ],
      "properties": {
        "kind": {
          "const": "library"
        },
        "schemaVersion": {
          "const": 2
        },
        "workouts": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/definitions/workout"
          }
        },
        "sessions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/definitions/session"
          }
        },
        "active": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/session"
            }
          ]
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "goals"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "role": {
          "enum": [
            "warmup",
            "work",
            "top",
            "backoff",
            "drop",
            "recovery",
            "technique",
            "cooldown",
            "custom"
          ]
        },
        "goals": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/goal"
          }
        }
      }
    }
  }
}
